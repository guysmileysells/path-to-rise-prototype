{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "contract": "node scripts/contract-check.mjs",
    "personalization": "node --experimental-transform-types scripts/personalization-scenarios.mjs",
    "progress": "node --experimental-transform-types scripts/progress-scenarios.mjs",
    "hardening": "node scripts/hardening-scenarios.mjs",
    "notifications": "node --experimental-transform-types scripts/notification-scenarios.mjs",
    "production-qa": "node --experimental-transform-types scripts/production-qa-scenarios.mjs",
    "final-audit": "node --experimental-transform-types scripts/final-launch-audit.mjs",
    "test": "npm run contract && npm run personalization && npm run progress && npm run hardening && npm run notifications && npm run production-qa && npm run final-audit && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
